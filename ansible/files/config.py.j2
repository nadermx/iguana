# Managed by ansible/deploy.yml (production). Secrets come from ~/.credentials on the deploy machine.
DEBUG = False
SECRET_KEY = '{{ django_secret_key }}'
# The site domains are here as well as the API ones: nginx proxies /orders/, /checkin/, /unsubscribe/,
# /newsletter/, /tables/, /revenue/ and /admin/ to this app on iguanacomedy.com too, so that a ticket link in
# an email and the QR a door scans carry the domain people recognise. Django answers 400 for a Host it has not
# been told about, which is what those pages did until this line included them.
ALLOWED_HOSTS = {{ ([api_domain] + api_alias_domains + [site_domain, 'www.' + site_domain]
                    + redirect_domains + (redirect_domains | map('regex_replace', '^', 'www.') | list)
                    + [server_ipv4, '127.0.0.1']) | to_json }}
BACKEND_URL = '{{ backend_url }}'
SITE_URLS = {{ site_urls | to_json }}
DATABASE = {
    'ENGINE': 'django.db.backends.postgresql',
    'NAME': '{{ db_name }}', 'USER': '{{ db_user }}', 'PASSWORD': '{{ db_password }}', 'HOST': 'localhost', 'PORT': '5432',
}
PUBLIC_API_KEYS = ['{{ public_api_key }}']
SECRET_API_KEYS = ['{{ secret_api_key }}']
STRIPE_PUBLISHABLE_KEY = '{{ stripe_publishable_key }}'
STRIPE_SECRET_KEY = '{{ stripe_secret_key }}'
STRIPE_WEBHOOK_SECRET = '{{ stripe_webhook_secret }}'
DEFAULT_FROM_EMAIL = '"Iguana Comedy" <no-reply@{{ site_domain }}>'
EMAIL_HOST = 'localhost'
EMAIL_PORT = 25
NOTIFY_EMAILS = {{ notify_emails | to_json }}
MARKETING_REPLY_TO = 'hello@{{ site_domain }}'
META_PIXEL_ID = '{{ meta_pixel_id }}'
META_CAPI_TOKEN = '{{ meta_capi_token }}'
TIKTOK_PIXEL_ID = '{{ tiktok_pixel_id | default('') }}'
TIKTOK_EVENTS_TOKEN = '{{ tiktok_events_token | default('') }}'
META_TEST_EVENT_CODE = '{{ meta_test_event_code }}'
# Read-only Marketing API access for the spend half of /stats/. Same system-user token as the CAPI one; it is
# a cron that uses it, never a request.
META_ADS_TOKEN = '{{ meta_ads_token }}'
META_AD_ACCOUNT = '{{ meta_ad_account }}'
GEOIP_DB = '{{ geoip_db }}'
DROP_PIN = '{{ drop_pin }}'
DROP_DIR = '{{ drop_dir }}'
COMICS_DIR = '{{ comics_dir | default('/var/lib/iguana/comics') }}'
