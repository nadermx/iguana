# Managed by ansible (tasks/nginx.yml). TLS server blocks are rendered from the certificates that exist,
# so re-running the deploy never strips HTTPS the way a certbot-edited conf would.
{% set tls_ok = live_certs | default([]) %}

upstream iguana_web { server 127.0.0.1:3000; keepalive 16; }
upstream iguana_api { server 127.0.0.1:8001; }

{% macro clicky_locations() %}
    # ---- Clicky anti-adblock proxy (https://clicky.com/help/proxy) ----
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;
    # Forward only Clicky's own first-party cookies.
    set $cookie "";
    if ($cookie__cky_ignore) {
        set $cookie "_cky_ignore=$cookie__cky_ignore; _cky_osa=$cookie__cky_osa";
    }
    location = {{ clicky_js_path }} {
        # A <script src> must never receive an HTML error page; answer empty JS instead.
        error_page 502 503 504 = @clicky_noop;
        set $clicky_js_upstream https://static.getclicky.com/js?in={{ clicky_beacon_path | urlencode | replace('/', '%2F') }};
        proxy_pass $clicky_js_upstream;
        proxy_connect_timeout 10s;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host static.getclicky.com;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie "";
    }
    location = {{ clicky_beacon_path }} {
        error_page 502 503 504 = @clicky_noop;
        # Only our own pages may send beacons (stops copied data-ids polluting stats).
        valid_referers none blocked server_names;
        if ($invalid_referer) { return 403; }
        set $clicky_beacon_upstream https://in.getclicky.com/in.php;
        proxy_pass $clicky_beacon_upstream$is_args$args;
        proxy_connect_timeout 10s;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host in.getclicky.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $cookie;
    }
    location @clicky_noop {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 "";
    }
{% endmacro %}

{% macro outage_pages() %}
    {# When gunicorn or the Node server is not up, nginx answers for them. The status is preserved (a plain
       error_page, never the `=` form), so monitoring and crawlers still see a 5xx: rewriting it to 200 would
       tell Google the outage page IS the show page, and it is also what makes a browser parse an HTML body
       that was requested as a script. Django's own 500s are not touched, because proxy_intercept_errors is
       off: this is only for an upstream that is not answering at all. #}
    error_page 502 503 504 /__outage.html;
    location = /__outage.html {
        internal;
        root /var/www/iguana-error;
        try_files /50x.html =503;
        add_header Cache-Control "no-store" always;
        add_header Retry-After 30 always;
    }
{% endmacro %}

{% macro outage_assets() %}
    {# Anything a page LOADS rather than navigates to must never receive that HTML. A <script src> answered
       with a page throws SyntaxError at line 1, and fetch() parsing it gets a stranger error still. Both of
       these live on api.* only, which is where the checkout, its tracker and the JSON API are served from. #}
    location = /_t/k.js {
        error_page 502 503 504 = @outage_js;
        proxy_pass http://iguana_api;
        include /etc/nginx/iguana_proxy_params;
    }
    location ^~ /api/ {
        error_page 502 503 504 @outage_json;
        proxy_pass http://iguana_api;
        include /etc/nginx/iguana_proxy_params;
    }
    location @outage_js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 "";
    }
    location @outage_json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After 30 always;
        return 200 '{"error":"The box office is restarting. Please try again in a moment. / La taquilla se esta reiniciando. Intenta de nuevo en un momento."}';
    }
{% endmacro %}

{% macro site_locations() %}
    # Apple Pay will not render at all unless Apple can fetch this, and Stripe re-checks ANNUALLY: when the
    # file goes missing it flips apple_pay to inactive silently and wallets just stop appearing. It is one
    # universal Stripe file (Stripe is the merchant on Apple's side), kept in the repo so it cannot quietly
    # vanish, and served on BOTH domains because the Payment Element runs inside the iframe on the API host.
    location = /.well-known/apple-developer-merchantid-domain-association {
        alias /var/www/wallet/apple-developer-merchantid-domain-association;
        default_type text/plain;
    }
    client_max_body_size 10m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
{{ outage_pages() }}
{% if clicky_site_id | default('') %}
{{ clicky_locations() }}
{% endif %}

    {# A build hashes its filename from its content, so a name that is gone is not a name that changed: it is
       last build's file, still exactly what its name says it holds. Somebody who had a page open when a deploy
       landed asks for it, gets a 404, and the island on that page never hydrates. Nothing reports that. The
       button just does nothing, and the only trace is a 404 here, which read as crawler noise for weeks.
       `dist.old` is the previous build the deploy keeps for rollback, so the fallback costs nothing. #}
    location ^~ /_astro/ {
        root {{ app_dir }}/dist/client;
        try_files $uri @last_build;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location @last_build {
        root {{ app_dir }}/dist.old/client;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    {# Two trees behind one path. `dist/client/media/` is the brand's own files, shipped with the build;
       `backend/media/` is what has been uploaded in the admin, which used to be reachable only on the API
       host. Serving both from iguanacomedy.com means a poster is same-origin with the page showing it: no
       second DNS lookup and no second TLS handshake in front of the largest image on the page. #}
    location ^~ /media/ {
        expires 7d;
        root {{ app_dir }}/dist/client;
        try_files $uri @uploads;
    }
    location @uploads {
        expires 7d;
        root {{ app_dir }}/backend;
    }

    {# The pages a person is sent to, on the domain they know. A ticket link in a confirmation email, the QR a
       door scans, an unsubscribe link and the staff boards were all on api.iguanacomedy.com, which reads as
       somebody else's domain in an inbox and is the first thing a phishing filter looks at.

       api.* keeps serving all of these too, so every QR already printed and every link in an email already
       sent still works. Only what we generate from now on uses the short host. The checkout iframe, k.js and
       /api/ stay there on purpose: they are a separate origin by design. #}
    location ^~ /orders/      { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /checkin/     { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /unsubscribe/ { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /newsletter/  { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /tables/      { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    {# La consola de piso: mesas e inventario, con su propio login y sin admin detrás. #}
    location ^~ /mesas/       { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    {# El punto de venta (backend/pos), y el celular del cliente pagando su cuenta en /pos/pagar/. #}
    location ^~ /pos/         { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    {# La puerta, en la dirección que se le da al personal: iguanacomedy.com/scan, con cualquier PIN. #}
    location = /scan          { return 301 /scan/; }
    location ^~ /scan/        { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    {# La lista de reservas, en la dirección corta que se le da al personal. #}
    location = /reservas      { return 301 /reservas/; }
    # Document uploads for account setup: phone photos of an ID run past the 10m default.
    location = /drop          { return 301 /drop/; }
    location ^~ /drop/        { client_max_body_size 60m; proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    {# Comedians send their photo and up to three clips (api/comic_views.py): 6 x 25 MB of photos plus 3 x 500 MB
       of video, with room for the form. Only this path takes it. nginx buffers the whole body to disk before
       gunicorn sees a byte, so a slow phone upload never holds one of the three sync workers; the hand-off over
       loopback and the rename into place take seconds, inside the 60s read timeout. #}
    location = /comic         { return 301 /comic/$is_args$args; }
    location ~ ^/(en|es)/comic/?$ { return 301 /comic/?lang=$1; }
    location ^~ /comic/       { client_max_body_size 1700m; client_body_timeout 120s; proxy_send_timeout 120s;
                                proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /reservas/    { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /reservations/ { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /stats/       { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location = /chat          { return 301 /chat/; }
    location ^~ /chat/        { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /revenue/     { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    location ^~ /admin/       { proxy_pass http://iguana_api; include /etc/nginx/iguana_proxy_params; }
    {# Django's own CSS and JS, for the admin login those pages redirect to. #}
    location ^~ /static/      { alias {{ app_dir }}/backend/staticfiles/; expires 7d; }

    location / {
        proxy_pass http://iguana_web;
        include /etc/nginx/iguana_proxy_params;
    }
{% endmacro %}

{% macro api_locations() %}
    client_max_body_size 10m;
{{ outage_pages() }}
{{ outage_assets() }}
    # Apple Pay will not render at all unless Apple can fetch this, and Stripe re-checks ANNUALLY: when the
    # file goes missing it flips apple_pay to inactive silently and wallets just stop appearing. It is one
    # universal Stripe file (Stripe is the merchant on Apple's side), kept in the repo so it cannot quietly
    # vanish, and served on BOTH domains because the Payment Element runs inside the iframe on the API host.
    location = /.well-known/apple-developer-merchantid-domain-association {
        alias /var/www/wallet/apple-developer-merchantid-domain-association;
        default_type text/plain;
    }
    location ^~ /static/ { alias {{ app_dir }}/backend/staticfiles/; expires 7d; }
    location ^~ /media/ { alias {{ app_dir }}/backend/media/; expires 7d; }
    location / {
        proxy_pass http://iguana_api;
        include /etc/nginx/iguana_proxy_params;
    }
{% endmacro %}

{% macro tls(name) %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/{{ name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:iguana_ssl:10m;
{% endmacro %}


# ---- {{ site_domain }} (canonical) ----
server {
    listen 80;
    listen [::]:80;
    server_name {{ site_domain }} www.{{ site_domain }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
{% if site_domain in tls_ok %}
    location / { return 301 https://{{ site_domain }}$request_uri; }
{% else %}
{{ site_locations() }}
{% endif %}
}
{% if site_domain in tls_ok %}
server {
    server_name www.{{ site_domain }};
{{ tls(site_domain) }}
    return 301 https://{{ site_domain }}$request_uri;
}
server {
    server_name {{ site_domain }};
{{ tls(site_domain) }}
{{ site_locations() }}
}
{% endif %}

# ---- redirected domains -> {{ site_domain }} (path kept) ----
{% for domain in redirect_domains %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }} www.{{ domain }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://{{ site_domain }}$request_uri; }
}
{% if domain in tls_ok %}
server {
    server_name {{ domain }} www.{{ domain }};
{{ tls(domain) }}
    return 301 https://{{ site_domain }}$request_uri;
}
{% endif %}
{% endfor %}

# ---- API: {{ api_domain }}{% for a in api_alias_domains %}, {{ a }}{% endfor %} ----
{% for host in [api_domain] + api_alias_domains %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ host }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
{% if host in tls_ok %}
    location / { return 301 https://{{ host }}$request_uri; }
{% else %}
{{ api_locations() }}
{% endif %}
}
{% if host in tls_ok %}
server {
    server_name {{ host }};
{{ tls(host) }}
{{ api_locations() }}
}
{% endif %}
{% endfor %}

# ---- {{ mail_domain }} (certificate for SMTP STARTTLS only) ----
server {
    listen 80;
    listen [::]:80;
    server_name {{ mail_domain }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://{{ site_domain }}/; }
}

# ---- bare IP ----
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
{{ site_locations() }}
}
{% if not dns_live | bool %}
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;
{{ api_locations() }}
}
{% endif %}
