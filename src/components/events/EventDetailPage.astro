---
import Base from "../../layouts/Base.astro";
import EventCheckoutWidget from "../EventCheckoutWidget.astro";
import EventFaq from "./EventFaq.astro";
import EventGallery, { type GalleryPhoto } from "./EventGallery.astro";
import type { KintanaPublicEvent } from "@kintana/sdk";
import {
  eventCollectsPayment,
  eventSupportsOnSiteCheckout,
  eventTicketTypeCount,
  formatEventScheduleLine,
  pastSeatsLine,
  pastSummary,
} from "../../lib/events";
import {
  eventVenueLabel,
  eventVenueMapsUrl,
  eventVenueMapEmbedUrl,
  formatEventHeroDateParts,
  splitEventDisplayTitle,
  eventHeroImageUrl,
  eventSocialDescription,
  absoluteMediaUrl,
} from "../../lib/event-hero";
import { getEventTicketingFaq } from "../../content/event-ticketing-faq";
import { eventReviews, formatStarRating } from "../../lib/event-reviews";
import { t } from "../../i18n/ui";
import { localizePath } from "../../i18n/routes";
import type { Locale } from "../../i18n/locale";
import { isOpenMic, walkInLine } from "../../lib/open-mics";
import { eventSchema } from "../../lib/structured-data";
import { stillOnSale } from "../../lib/still-on-sale";

interface Props {
  event: KintanaPublicEvent | null;
  locale: Locale;
}

const { event, locale } = Astro.props;

const ticketingBlocked = Boolean(event?.status === "sold-out" || event?.status === "postponed" || event?.status === "past");
// A show that is over keeps its page (posters, line-up, reviews) but the form comes down and the box says what
// happened instead: whether it sold out and how many seats went.
const past = pastSummary(event);
const pastFree = Boolean(event && (isOpenMic(event) || event.priceFrom === 0));
const pastLine = event && past ? pastSeatsLine(past, locale, pastFree) : null;
// Only fetched for the page that needs it: a visitor told "no" has already decided to come out, and a dated,
// clickable list is the difference between a lost visit and a different one.
const alsoOn = event?.status === "sold-out" || event?.status === "past" ? await stillOnSale(event.id, locale) : [];
const onSiteCheckout = event ? eventSupportsOnSiteCheckout(event) : false;
const posterMobileSrc = event?.imageUrlMobile?.trim() || event?.imageUrl;
const heroPoster = event ? eventHeroImageUrl(event) : null;
const siteOrigin = Astro.site?.origin ?? "https://iguanacomedy.com";
// The show itself, for Google's event listings: date, venue, price, who is on. Built from the same fields the
// page prints, because structured data that disagrees with the page is worse than none.
const showSchema = event ? eventSchema(event, siteOrigin, new URL(Astro.url.pathname, siteOrigin).toString()) : null;

// The hero draws one crop on a phone and another from `md` up, so each preload carries the matching query.
// Without them a phone downloads both and the preload makes the page slower than having none.
// Anyone the event bills with something to say about them gets an introduction; the rest stay a list. `bio`
// and `reels` ride along on every lineup entry, so a two-hander is not a special case.
type Billed = (typeof event extends null ? never : NonNullable<typeof event>)["lineup"][number] & {
  bio?: string;
  reels?: Array<{ title: string; url: string; posterUrl: string | null }>;
};
const lineup = (event?.lineup ?? []) as Billed[];
const billed = lineup.filter((member) => member.bio || member.reels?.length);
const supporting = lineup.filter((member) => !(member.bio || member.reels?.length));

const heroPreloads = [
  ...(posterMobileSrc ? [{ href: posterMobileSrc, media: "(max-width: 767px)" }] : []),
  ...(heroPoster ? [{ href: heroPoster, media: "(min-width: 768px)" }] : []),
];
const socialDescription = event
  ? eventSocialDescription(event, locale, t(locale, "seo.defaultDescription"))
  : t(locale, "seo.defaultDescription");
const socialImage = heroPoster ? absoluteMediaUrl(heroPoster, siteOrigin) : undefined;
const dateParts = event ? formatEventHeroDateParts(event.date, locale) : null;
const { headline, subtitle } = event ? splitEventDisplayTitle(event.name) : { headline: "", subtitle: null };
const venueName = event ? eventVenueLabel(event) : "";
const venueAddress = event?.venue?.address?.trim() || "";
const mapsUrl = event ? eventVenueMapsUrl(event) : null;
const mapEmbedUrl = event ? eventVenueMapEmbedUrl(event) : null;
// Open mics sell reservations, so every label says "reserve" rather than "buy".
const checkoutLabel = event && isOpenMic(event) ? t(locale, "ui.reserveSeat") : t(locale, "ui.buyTickets");
const externalTicketUrl = !onSiteCheckout && !ticketingBlocked ? event?.ticketUrl ?? null : null;
const hasIntro = Boolean(
  event && ((event.headliner && event.headliner.name !== headline) || event.description || event.longDescription),
);
// Photos of the room and the shows around the description (`gallery` is ours, not in the SDK's types).
const gallery = ((event as { gallery?: GalleryPhoto[] } | null)?.gallery ?? []).filter((photo) => photo?.url);
const galleryBefore = gallery.filter((photo) => photo.section !== "after");
const galleryAfter = gallery.filter((photo) => photo.section === "after");
// A web address written into the description (a host's Instagram, say) becomes a link; the rest stays text.
const linkParts = (text: string) =>
  text.split(/(https?:\/\/[^\s<>"]+)/g).filter(Boolean).map((part) => {
    if (!/^https?:\/\//.test(part)) return { text: part, href: null };
    const href = part.replace(/[.,;:!?)]+$/, "");
    return { text: href, href, tail: part.slice(href.length) };
  }).flatMap((part) => ("tail" in part && part.tail ? [part, { text: part.tail, href: null }] : [part]));
const faq = event ? getEventTicketingFaq(locale, event) : getEventTicketingFaq(locale);
const reviews = event ? eventReviews(event) : [];
// Meta ViewContent for this show. The sale itself is reported server-side, from the checkout iframe's own origin.
const pixelContent = event
  ? {
      id: event.id,
      name: event.name,
      ...(event.priceFrom != null ? { value: event.priceFrom / 100 } : {}),
      ...(event.priceCurrency ? { currency: event.priceCurrency } : {}),
    }
  : undefined;
---

<Base
  noindex={!event}
  title={event ? `${event.name} · ${t(locale, "events.title")}` : `${t(locale, "events.title")} · Iguana Comedy`}
  description={socialDescription}
  ogImage={socialImage}
  narrow={false}
  pixelContent={pixelContent}
  schema={showSchema}
  preloadImage={heroPreloads}
  transparentHeader={Boolean(event)}
  flushMain={Boolean(event)}
>
  {
    !event ? (
      <section class="mx-auto max-w-5xl px-6 pb-24 pt-20">
        <a class="text-xs font-semibold uppercase tracking-[0.45em] text-brand underline-offset-[0.5rem] hover:underline" href={localizePath(locale, "events")}>
          {t(locale, "events.backToCalendar")}
        </a>
        <p class="mt-24 text-neutral-600">{t(locale, "events.notFound")}</p>
      </section>
    ) : (
      <>
        {/* The fold is the offer. The poster is the backdrop, not the thing that fills the screen: an ad click
            arrives here to reserve a seat, and a full-height photo made them scroll past the title to find the
            form. Phones get a compact band and the form right under it; desktop puts the form beside it. */}
        <section class="relative isolate overflow-hidden bg-neutral-950">
          {
            heroPoster ? (
              <div class="absolute inset-x-0 top-0 h-full" data-hero-backdrop aria-hidden="true">
                <img src={heroPoster} alt="" class="absolute inset-0 hidden size-full object-cover md:block" loading="eager" fetchpriority="high" />
                <img src={posterMobileSrc ?? heroPoster} alt="" class="absolute inset-0 size-full object-cover md:hidden" loading="eager" fetchpriority="high" />
                {/* Even, and heavier at the bottom so the card has something to sit against. It used to be
                    darkest down the left, which is where the words were before they moved to the middle. */}
                <div class="absolute inset-0 bg-neutral-950/60" />
                <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-neutral-950 to-transparent" />
                {/* The poster is cropped to cover this layer, so if the layer followed the section it would
                    re-crop, which reads as a zoom, every time the checkout beside it changed height: Stripe
                    drawing, a "+", an error line (owner, 2026-10-09). It is pinned to the height it first
                    paints at; anything the section gains below that is the same near-black the fade ends in.
                    Re-measured only when the WIDTH changes, i.e. a rotation or a resized window. */}
                <script is:inline>
                  (function () {
                    var layer = document.currentScript.parentElement, section = layer.parentElement, width = 0;
                    function pin() {
                      if (window.innerWidth === width) return;
                      width = window.innerWidth;
                      layer.style.height = "";
                      layer.style.height = section.getBoundingClientRect().height + "px";
                    }
                    // After the whole section is parsed (title and checkout reserve come after this), before k.js
                    // swaps the iframe in, which is already the height the reserve held.
                    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", pin);
                    else pin();
                    window.addEventListener("resize", pin);
                  })();
                </script>
              </div>
            ) : null
          }
          {
            heroPoster ? (
              /* The fade at the section's own bottom as well, so the edge is fully dark whether the pinned
                 layer above ended up a little taller than the section or a little shorter. */
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-neutral-950 to-transparent" aria-hidden="true" />
            ) : null
          }

          {/* One centred column, the form directly under the name of the show. The form used to sit in a
              right-hand rail, which read as an aside to the page rather than the point of it. */}
          <div class="relative z-10 mx-auto grid max-w-page gap-6 px-4 pb-12 pt-20 text-center sm:gap-8 sm:px-6 sm:pt-24 lg:gap-8 lg:px-8 lg:pb-16 lg:pt-24">
            <div class="min-w-0">
              <a class="inline-flex text-xs font-semibold uppercase tracking-[0.45em] text-white/85 hover:text-white" href={localizePath(locale, "events")}>
                {t(locale, "events.backToCalendar")}
              </a>

              <h1 class="mx-auto mt-4 max-w-3xl font-display sm:mt-6 text-[clamp(2.1rem,5.2vw,3.4rem)] leading-[0.97] text-white" style="font-family: var(--font-display);">
                {headline}
              </h1>
              {subtitle ? <p class="mx-auto mt-3 max-w-2xl text-lg text-white/90 md:text-2xl">{subtitle}</p> : null}

              {/* Date and place only. The doors and show times are printed again at the top of the card a few
                  centimetres below, and saying them twice costs the fold two lines on a phone. */}
              <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
                {/* Badge and venue share a row rather than stacking: on a phone two centred blocks cost a
                    hundred pixels of fold, which is the difference between seeing the form and not. */}
                <div class="flex items-center gap-3">
                  {
                    dateParts ? (
                      <div class="flex min-w-[4.25rem] shrink-0 flex-col items-center rounded-lg bg-brand px-3 py-2 text-center text-neutral-950 shadow-lg">
                        <span class="text-[10px] font-semibold uppercase tracking-wide">{dateParts.weekday}</span>
                        <span class="font-display text-2xl leading-none" style="font-family: var(--font-display);">{dateParts.day}</span>
                        <span class="text-[10px] font-semibold uppercase tracking-wide">{dateParts.month}</span>
                      </div>
                    ) : null
                  }
                  {
                    venueName ? (
                      <p class="min-w-0 text-xs font-semibold uppercase tracking-[0.16em] text-white/85 sm:text-sm sm:tracking-[0.22em]">
                        {venueName}{event.city ? ` · ${event.city}` : ""}
                      </p>
                    ) : null
                  }
                </div>
                {
                  event.status === "sold-out" || event.status === "postponed" ? (
                    <span class="rounded-full bg-white/15 px-4 py-2 text-xs font-semibold uppercase tracking-[0.35em] text-white backdrop-blur-sm">
                      {event.status === "sold-out" ? `${t(locale, "ui.soldOut")}${isOpenMic(event) ? "*" : ""}` : t(locale, "ui.postponed")}
                    </span>
                  ) : null
                }
              </div>

              {
                /* Only when somebody else sells the tickets. Our own form is right there, so a button that
                   scrolls to it would be a button that scrolls to itself. */
                externalTicketUrl ? (
                  <a
                    href={externalTicketUrl}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="mt-7 flex min-h-12 w-full items-center justify-center gap-3 rounded-full bg-brand px-8 py-3.5 text-sm font-semibold uppercase tracking-[0.2em] text-neutral-950 transition hover:brightness-110 sm:mx-auto sm:w-auto"
                  >
                    {checkoutLabel}
                    <span aria-hidden="true">→</span>
                  </a>
                ) : null
              }
            </div>

            <aside id="checkout" class="mx-auto w-full min-w-0 max-w-[28rem] scroll-mt-24">
              {
                onSiteCheckout ? (
                  <div class="overflow-visible rounded-xl border-t-4 border-brand bg-white shadow-[0_18px_50px_-18px_rgba(0,0,0,0.7)] ring-1 ring-black/10">
                    {/* A plain heading, not a green bar: it must not look like a second button. */}
                    <div class="border-b border-black/10 px-4 pb-3 pt-4 sm:px-5">
                      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-neutral-950">{checkoutLabel}</h2>
                      <p class="mt-1 text-sm text-neutral-600">{formatEventScheduleLine(event, locale)}</p>
                    </div>
                    <EventCheckoutWidget
                      eventId={event.id}
                      locale={locale}
                      blocked={ticketingBlocked}
                      collectsPayment={eventCollectsPayment(event)}
                      ticketTypes={eventTicketTypeCount(event)}
                      width="card"
                      class="!min-h-0 !rounded-none !border-0 !bg-white !px-4 !py-4 sm:!px-5"
                    />
                  </div>
                ) : event.status === "sold-out" || past ? (
                  /* Where the reservation form was. "Tickets are not available right now" is what a page says
                     when something is broken, and somebody who came to buy reads it as a fault to work around
                     rather than an answer. The answer is one word, in the place they were looking. */
                  <div class="overflow-hidden rounded-xl border-t-4 border-white bg-neutral-950 text-center shadow-[0_18px_50px_-18px_rgba(0,0,0,0.7)] ring-1 ring-white/15">
                    {past ? (
                      <p class="px-4 pt-6 text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-white/70">
                        {t(locale, "events.pastKicker")}
                      </p>
                    ) : null}
                    <p
                      class:list={["px-4 uppercase leading-none text-white", past ? "pt-3" : "pt-7"]}
                      style="font-family: var(--font-display); font-size: clamp(2.6rem, 9vw, 4rem); letter-spacing: 0.06em;"
                    >
                      {past
                        ? past.soldOut
                          ? t(locale, "ui.soldOut")
                          : t(locale, "events.pastOver")
                        : `${t(locale, "ui.soldOut")}${isOpenMic(event) ? "*" : ""}`}
                    </p>
                    {past ? (
                      pastLine ? <p class="px-6 pb-6 pt-3 text-base font-semibold text-white">{pastLine}</p> : <div class="pb-6" />
                    ) : (
                      <p class="px-6 pb-6 pt-3 text-sm text-white/80">
                        {isOpenMic(event) ? walkInLine(event, locale) : t(locale, "events.soldOutNote")}
                      </p>
                    )}
                    {
                      alsoOn.length ? (
                        <div class="border-t border-white/15 px-4 pb-5 pt-5 text-left sm:px-5">
                          <p class="mb-3 text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-white/70">
                            {t(locale, "events.stillOnSale")}
                          </p>
                          <ul class="space-y-2">
                            {alsoOn.map((other) => (
                              <li>
                                <a
                                  class="flex min-h-[3.25rem] items-center justify-between gap-3 rounded-xl bg-white/10 px-4 py-3 text-white transition hover:bg-white hover:text-neutral-950"
                                  href={localizePath(locale, "eventDetail", { slug: other.slug })}
                                >
                                  <span class="min-w-0">
                                    <span class="block truncate text-sm font-semibold">{other.name}</span>
                                    <span class="block text-xs opacity-80">{formatEventScheduleLine(other, locale)}</span>
                                  </span>
                                  <span aria-hidden="true" class="text-lg leading-none">&rsaquo;</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ) : null
                    }
                  </div>
                ) : ticketingBlocked ? (
                  <p class="rounded-xl border border-white/15 bg-white/10 px-6 py-10 text-center text-sm text-white backdrop-blur-sm">{t(locale, "events.ticketsUnavailable")}</p>
                ) : null
              }
            </aside>
          </div>
        </section>

        <section class="relative bg-white pb-20 pt-12">
          <div class="mx-auto grid max-w-3xl gap-10 px-4 sm:px-6 lg:px-8">
            <EventGallery photos={galleryBefore} />
            {hasIntro ? (
            <div class="min-w-0 space-y-10 text-neutral-950">
              {/* Only when nothing further down introduces them. With a bio and a clip below, this line put the
                  same name under two headings in the same column. */}
              {
                event.headliner && event.headliner.name !== headline && !billed.length ? (
                  <p class="text-sm font-semibold uppercase tracking-[0.38em] text-neutral-500">
                    {t(locale, "events.spotlight").replace("{name}", event.headliner.name)}
                  </p>
                ) : null
              }

              {
                event.description || event.longDescription ? (
                  <div class="space-y-4 text-lg leading-relaxed text-neutral-700">
                    {event.description ? <p>{event.description}</p> : null}
                    {
                      // The long description almost always opens by repeating the short one (that is how the
                      // catalogue was written), so drop the paragraph we just printed.
                      event.longDescription
                        ? event.longDescription
                            .split(/\r?\n\s*\r?\n/)
                            .map((chunk) => chunk.trim())
                            .filter((chunk) => chunk.length > 0 && chunk !== event.description?.trim())
                            .map((chunk) => (
                              <p class="whitespace-pre-line">
                                {linkParts(chunk).map((part) =>
                                  part.href ? (
                                    <a href={part.href} target="_blank" rel="noopener" class="break-all font-medium text-brand underline underline-offset-2">
                                      {part.text}
                                    </a>
                                  ) : (
                                    part.text
                                  ),
                                )}
                              </p>
                            ))
                        : null
                    }
                  </div>
                ) : null
              }
            </div>
            ) : null}
            <EventGallery photos={galleryAfter} />

            <div class="min-w-0 space-y-10 text-neutral-950">
              {
                reviews.length > 0 ? (
                  <ul class="space-y-3 border-y border-black/10 py-8 text-sm text-neutral-700">
                    {
                      reviews.map((item) => (
                        <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                          {item.quote ? <span class="text-neutral-800">‘{item.quote}’</span> : null}
                          <span class="text-brand">{formatStarRating(item.stars)}</span>
                          <span class="text-neutral-500">{item.source}</span>
                        </li>
                      ))
                    }
                  </ul>
                ) : null
              }

              {
                venueName ? (
                  <section id="venue" class="space-y-4">
                    <h2 class="text-xs font-semibold uppercase tracking-[0.42em] text-neutral-400">{t(locale, "events.venueTitle")}</h2>
                    <div class="space-y-4">
                      <div class="space-y-2">
                        <p class="text-xl font-semibold text-neutral-950">{venueName}</p>
                        {venueAddress ? <p class="text-base text-neutral-600">{venueAddress}</p> : null}
                      </div>
                      {
                        mapEmbedUrl ? (
                          <div class="overflow-hidden rounded-2xl border border-black/10">
                            <iframe
                              title={t(locale, "events.mapTitle", { venue: venueName })}
                              src={mapEmbedUrl}
                              width="100%"
                              height="280"
                              style="border: 0;"
                              allowfullscreen
                              loading="lazy"
                              referrerpolicy="no-referrer-when-downgrade"
                              class="block w-full"
                            />
                          </div>
                        ) : null
                      }
                      {
                        mapsUrl ? (
                          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex text-sm font-semibold text-brand underline-offset-4 hover:underline">
                            {t(locale, "events.viewOnMaps")}
                          </a>
                        ) : null
                      }
                    </div>
                  </section>
                ) : null
              }

              {/* Who is on, before the list of who else is on. An event page selling a named act has to be
                  about that act: the poster said who it was and the page said nothing about them. */}
              {
                billed.length ? (
                  <section class="space-y-8">
                    <h2 class="text-xs font-semibold uppercase tracking-[0.42em] text-neutral-400">
                      {t(locale, "events.whoIsOn")}
                    </h2>
                    {billed.map((member) => (
                      <div class="space-y-5">
                        <div class="flex items-center justify-center gap-4">
                          {member.imageUrl ? (
                            <img src={member.imageUrl} alt="" class="size-20 rounded-2xl object-cover" loading="lazy" />
                          ) : null}
                          <div class="min-w-0 text-left">
                            <a
                              class="font-display text-3xl text-neutral-950 hover:text-brand"
                              style="font-family: var(--font-display);"
                              href={localizePath(locale, "comedianDetail", { slug: member.slug })}
                            >
                              {member.name}
                            </a>
                            {member.role ? <p class="text-sm text-neutral-500">{member.role}</p> : null}
                          </div>
                        </div>
                        {member.bio ? <p class="text-lg leading-relaxed text-neutral-700">{member.bio}</p> : null}
                        {member.reels?.length ? (
                          <div
                            class:list={[
                              "mx-auto grid gap-4",
                              member.reels.length > 1 ? "sm:grid-cols-2" : "max-w-sm",
                            ]}
                          >
                            {member.reels.slice(0, 2).map((reel) => (
                              <video
                                class="mx-auto w-full rounded-2xl border border-black/10 bg-neutral-950"
                                src={reel.url}
                                poster={reel.posterUrl ?? undefined}
                                controls
                                playsinline
                                preload="none"
                                aria-label={reel.title || member.name}
                              />
                            ))}
                          </div>
                        ) : null}
                      </div>
                    ))}
                  </section>
                ) : null
              }

              {
                supporting.length ? (
                  <section class="space-y-6">
                    <h2 class="text-xs font-semibold uppercase tracking-[0.42em] text-neutral-400">{t(locale, "events.featuredVoices")}</h2>
                    <ul class="space-y-4">
                      {supporting.map((member) => (
                        <li class="flex items-center gap-4 border-b border-black/10 pb-4">
                          {member.imageUrl ? <img src={member.imageUrl} alt="" class="size-14 rounded-2xl object-cover" loading="lazy" /> : null}
                          <div class="min-w-0 flex-1">
                            <a class="text-lg font-semibold text-neutral-950 hover:text-brand" href={localizePath(locale, "comedianDetail", { slug: member.slug })}>
                              {member.name}
                            </a>
                            {member.role ? <p class="text-sm text-neutral-500">{member.role}</p> : null}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </section>
                ) : null
              }

              <EventFaq faq={faq} title={t(locale, "events.faqTitle")} />
            </div>
          </div>
        </section>
      </>
    )
  }
</Base>
