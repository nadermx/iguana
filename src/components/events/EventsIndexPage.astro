---
import Base from "../../layouts/Base.astro";
import CityPicker from "../CityPicker.astro";
import EventRow from "../EventRow.astro";
import EventCalendarRow from "./EventCalendarRow.astro";
import NewsletterSignup from "../NewsletterSignup.astro";
import OpenMicCallout from "../OpenMicCallout.astro";
import NoEventsNearby from "../locations/NoEventsNearby.astro";
import type { KintanaPublicEvent } from "@kintana/sdk";
import { heroCityChoices } from "../../content/site";
import { eventCitySlug, groupEventsByMonth, splitByCurrentMonth } from "../../lib/events";
import { isOpenMic } from "../../lib/open-mics";
import { loadEventsForCalendarPages } from "../../lib/events-catalog";
import { logKintanaError, logKintanaSuccess, kintanaHttpStatus } from "../../lib/kintana-error";
import { createLocalizedKintanaClient, getKintanaEnv } from "../../lib/kintana-env";
import type { Locale } from "../../i18n/locale";
import { t } from "../../i18n/ui";
import { localizePath } from "../../i18n/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const { apiKey, baseUrl, hasCredentials } = getKintanaEnv();

const citySlugFilter = Astro.url.searchParams.get("city") ?? "";

const cityPickerChoices = [
  { slug: "", label: locale === "es" ? "Toda la costa" : "Whole coastline" },
  ...heroCityChoices.filter((entry) => entry.slug !== ""),
];

const activeCityLabel = cityPickerChoices.find((entry) => entry.slug === citySlugFilter)?.label;

let upcoming: KintanaPublicEvent[] = [];
let past: KintanaPublicEvent[] = [];
let listingsRequestFailed = false;
let listingsHttpStatus: number | undefined;

if (hasCredentials) {
  try {
    const client = createLocalizedKintanaClient(locale);
    const loaded = await loadEventsForCalendarPages(client);
    upcoming = loaded.upcoming;
    past = loaded.past;
    logKintanaSuccess(`listEvents /events (calendar)`, upcoming.length + past.length);
  } catch (err) {
    logKintanaError("listEvents /events", err);
    listingsHttpStatus = kintanaHttpStatus(err);
    listingsRequestFailed = true;
    upcoming = [];
    past = [];
  }
}

if (citySlugFilter) {
  upcoming = upcoming.filter((evt) => eventCitySlug(evt) === citySlugFilter);
  past = past.filter((evt) => eventCitySlug(evt) === citySlugFilter);
}

// A city with nothing coming up (other than Playa itself) points people to the club in Playa instead of a dead end.
const nearbyCity =
  citySlugFilter && activeCityLabel && citySlugFilter !== "playa-del-carmen" ? { slug: citySlugFilter, label: activeCityLabel } : null;

// The page leads with what is on this month; everything after that lives in the calendar you can open, so the
// weekly open mics do not bury the rest of the year.
const { thisMonth, later } = splitByCurrentMonth(upcoming);
// Never fewer than four up top (owner, 2026-09-26): at the end of a month "this month" can be two nights, and a
// page that leads with two cards reads as a club with nothing on. Topped up from next month in date order.
const FEATURED_MIN = 4;
// Ticketed shows lead, whatever month they are in, and the open mics follow (owner, 2026-11-07: "we need to sell
// tickets for this one rather than all the open mics appearing first"; the open mic ads link to their own page).
// Each group keeps date order. This month's open mics all stay, topped up from later ones to the minimum.
const ticketed = [...thisMonth, ...later].filter((evt) => !isOpenMic(evt));
const openMicsThisMonth = thisMonth.filter((evt) => isOpenMic(evt));
const openMicsTopUp = later.filter((evt) => isOpenMic(evt))
  .slice(0, Math.max(0, FEATURED_MIN - ticketed.length - openMicsThisMonth.length));
const featured = [...ticketed, ...openMicsThisMonth, ...openMicsTopUp];
// The calendar is whole months, so a month that also lends shows to the top still lists all of them: October
// missing its first two nights read as a broken calendar. Repeating a show is the lesser evil (owner, 2026-09-26).
// A night leaves both lists by itself the day after it happens, when the API marks it past.
const calendar = later;
// "This month" only while it is true; once next month's shows are in the list the heading says "Upcoming".
const featuredIsThisMonth = featured.every((evt) => thisMonth.includes(evt));
const calendarGrouped = groupEventsByMonth(calendar, "asc", locale);
const pastGrouped = groupEventsByMonth(past, "desc", locale);
const hasAnyShows = upcoming.length > 0 || pastGrouped.size > 0;
const calendarCount = calendar.length;
const calendarCountLabel = t(locale, calendarCount === 1 ? "events.calendarCountOne" : "events.calendarCountOther")
  .replace("{count}", String(calendarCount));

const emptyMessage =
  citySlugFilter && activeCityLabel
    ? t(locale, "home.eventsEmptyCity").replace("{city}", activeCityLabel)
    : t(locale, "events.empty");
---

<Base narrow={false} title={`${t(locale, "events.title")} · Iguana Comedy`} transparentHeader={false}>
  <section class="mx-auto max-w-page px-6 pb-24 pt-20">
    <div class="max-w-xs">
      <p class="text-xs font-semibold uppercase tracking-[0.45em] text-neutral-500">
        {locale === "es" ? "Ciudad destacada" : "Spotlight city"}
      </p>
      <CityPicker
        variant="light"
        navigateTo="events"
        eventsBaseHref={localizePath(locale, "events")}
        choices={cityPickerChoices}
        value={citySlugFilter}
        locale={locale}
      />
    </div>

    {!hasCredentials ? (
      <div class="mt-16 rounded-3xl border border-amber-200 bg-amber-50 px-6 py-6 text-neutral-950">
        {t(locale, "events.noCredentials")}
      </div>
    ) : listingsRequestFailed ? (
      <div class="mt-16 space-y-3 rounded-3xl border border-red-300 bg-red-50 px-6 py-12 text-neutral-900">
        <p class="font-semibold">
          {
            listingsHttpStatus === 401
              ? t(locale, "events.error.401")
              : listingsHttpStatus != null
                ? t(locale, "events.error.http").replace("{status}", String(listingsHttpStatus))
                : t(locale, "events.error.generic")
          }
        </p>
        {listingsHttpStatus === 401 ? (
          <p class="text-sm leading-relaxed">
            {t(locale, "events.error.401Help")}
          </p>
        ) : (
          <p class="text-sm leading-relaxed">{t(locale, "events.error.logsHelp")}</p>
        )}
      </div>
    ) : !hasAnyShows ? (
      nearbyCity ? (
        <NoEventsNearby locale={locale} city={nearbyCity} />
      ) : (
        <div class="mt-16 rounded-3xl border border-neutral-200 px-6 py-12 text-neutral-700">
          {emptyMessage}
        </div>
      )
    ) : (
      <div class="mt-20 space-y-20">
        <div>
          <h2 class="text-center font-display text-3xl text-neutral-950" style="font-family: var(--font-display);">
            {citySlugFilter && activeCityLabel
              ? t(locale, "home.upcomingIn").replace("{city}", activeCityLabel)
              : featuredIsThisMonth
                ? t(locale, "events.thisMonth")
                : t(locale, "home.upcoming")}
          </h2>
          {featured.length === 0 ? (
            nearbyCity ? (
              <NoEventsNearby locale={locale} city={nearbyCity} />
            ) : (
              <p class="mt-8 text-neutral-600">{t(locale, "events.noUpcoming")}</p>
            )
          ) : (
            <>
              {thisMonth.length === 0 ? <p class="mt-6 text-center text-neutral-600">{t(locale, "events.noneThisMonth")}</p> : null}
              <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-14">
                {featured.map((evt) => (
                  <EventRow evt={evt} highlightCity={citySlugFilter} locale={locale} />
                ))}
              </div>
            </>
          )}
        </div>

        {/* Below the shows on sale, above the calendar. Leading the page with it pushed the actual line-up down
            and repeated what the visitor has already read on the way here. */}
        {!citySlugFilter || citySlugFilter === "playa-del-carmen" ? <OpenMicCallout locale={locale} events={upcoming} /> : null}

        {calendarCount > 0 ? (
          <details class="group border-t border-neutral-200 pt-10" data-events-calendar open>
            <summary class="mx-auto flex max-w-4xl cursor-pointer list-none items-center justify-center gap-4">
              <span class="font-display text-2xl text-neutral-950 sm:text-3xl" style="font-family: var(--font-display);">
                <span class="group-open:hidden">{t(locale, "events.calendarToggle")}</span>
                <span class="hidden group-open:inline">{t(locale, "events.calendarHide")}</span>
              </span>
              <span class="flex items-center gap-4">
                <span class="hidden text-sm text-neutral-600 group-open:sm:hidden sm:block">{calendarCountLabel}</span>
                <span class="text-3xl leading-none text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
              </span>
            </summary>
            <div class="mx-auto mt-10 max-w-4xl space-y-12">
              {Array.from(calendarGrouped.entries()).map(([month, rows]) => (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.45em] text-neutral-500">{month}</p>
                  <div class="mt-4 border-t border-black/10">
                    {rows.map((evt) => (
                      <EventCalendarRow evt={evt} locale={locale} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </details>
        ) : null}

        <div class="border-t border-neutral-200 pt-12">
          <p class="mx-auto max-w-xl text-neutral-600">{t(locale, "events.newsletterPitch")}</p>
          <NewsletterSignup locale={locale} class="mx-auto mt-8 max-w-md" />
        </div>

        {pastGrouped.size > 0 ? (
          <details class="group border-t border-neutral-200 pt-10">
            <summary class="mx-auto flex max-w-4xl cursor-pointer list-none items-center justify-center gap-4">
              <span class="font-display text-2xl text-neutral-950 sm:text-3xl" style="font-family: var(--font-display);">
                {t(locale, "events.pastToggle")}
              </span>
              <span class="text-3xl leading-none text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600">{t(locale, "events.pastDescription")}</p>
            <div class="mx-auto mt-10 max-w-4xl space-y-12">
              {Array.from(pastGrouped.entries()).map(([month, rows]) => (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.45em] text-neutral-500">{month}</p>
                  <div class="mt-4 border-t border-black/10">
                    {rows.map((evt) => (
                      <EventCalendarRow evt={evt} locale={locale} past />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </details>
        ) : null}
      </div>
    )}
  </section>
</Base>
