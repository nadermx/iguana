---
import { site } from "../content/site";
import NewsletterSignup from "./NewsletterSignup.astro";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routes";
import type { Locale } from "../i18n/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const whatsappHref = `https://wa.me/${site.whatsappE164.replace(/\D+/g, "")}`;
// Turn-by-turn from wherever they are, pinned to the club's own listing rather than to a text search.
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.venueAddress)}&destination_place_id=${site.venuePlaceId}`;
---

<footer class="border-t border-black/10 bg-ink pb-16 pt-20 text-center text-neutral-300">
  <div class="mx-auto max-w-page px-4 sm:px-6">
    <div class="min-w-0 space-y-6">
      <p class="text-4xl text-white lg:text-[2.75rem]" style="font-family: var(--font-display);">{site.name}</p>
      <!-- The catch-all: every page offers a way onto the list, for the people who read and do not book today. -->
      <NewsletterSignup locale={locale} tone="dark" class="mx-auto max-w-md pt-2" />
      <div class="space-y-4 text-neutral-400">
        <a class="block text-base text-white underline-offset-4 transition hover:underline" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <a
          class="block tracking-wide text-neutral-400 transition hover:text-white"
          href={whatsappHref}
          target="_blank"
          rel="noreferrer noopener"
        >
          <span class="block text-lg text-white">{site.whatsappDisplay}</span>
          <span class="block text-sm uppercase tracking-[0.45em] text-neutral-400">{t(locale, "footer.whatsappLabel")}</span>
          <span class="block text-sm lowercase text-neutral-500">{t(locale, "footer.whatsappSub")}</span>
        </a>

        {/* Where the club is, on every page. It used to appear only at the bottom of the open mic callout, so a
            visitor on any other page had nowhere to find the address. A link rather than an embedded map: the
            map belongs on the pages about a night, and an iframe in the footer is one on every page load. */}
        <address class="not-italic">
          <span class="block text-sm uppercase tracking-[0.45em] text-neutral-500">{t(locale, "footer.locatedAt")}</span>
          <a
            class="mt-2 block text-base leading-relaxed text-white underline-offset-4 transition hover:underline"
            href={site.venueMapsUrl}
            target="_blank"
            rel="noreferrer noopener"
          >
            {site.venueAddress}
          </a>
          <a
            class="mt-2 inline-block text-sm uppercase tracking-[0.35em] text-brand underline-offset-4 hover:underline"
            href={directionsHref}
            target="_blank"
            rel="noreferrer noopener"
          >
            {t(locale, "locations.directions")} →
          </a>
        </address>
      </div>
    </div>

    <!-- The four link columns are their own grid: as part of the brand grid they left a dead fifth column and a
         gaping hole down the right of the footer. -->
    <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
    <div>
      <p class="pb-6 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.navigate")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "events")}>{t(locale, "footer.shows")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "locations")}>{t(locale, "footer.locations")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "comedians")}>{t(locale, "footer.wallOfComedians")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "menu")}>{t(locale, "footer.menu")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "videos")}>{t(locale, "footer.videos")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "store")}>{t(locale, "nav.merch")}</a>
      </nav>
    </div>
    <div>
      <p class="pb-6 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.info")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "about")}>{t(locale, "footer.story")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "contact")}>{t(locale, "nav.contact")}</a>
      </nav>
    </div>
    <div>
      <p class="pb-6 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.workWithGroup")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "hotelsAndResorts")}>{t(locale, "footer.hotelsAndResorts")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "workWithUs")}>{t(locale, "footer.workWithUs")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "performWithUs")}>{t(locale, "footer.performWithUs")}</a>
        <a class="block hover:text-brand" href={`/comic/?lang=${locale}`}>{t(locale, "footer.becomeComedian")}</a>
      </nav>
    </div>
    <div>
      <p class="pb-6 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.legal")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "privacyPolicy")}>{t(locale, "footer.privacy")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "termsAndConditions")}>{t(locale, "footer.terms")}</a>
      </nav>
    </div>
    </div>
  </div>
  <div
    class="mx-auto mt-14 flex max-w-page flex-col items-center gap-6 border-t border-white/15 px-4 pt-8 sm:px-6"
  >
    <p class="text-sm text-neutral-500">© {new Date().getFullYear()} Iguana Comedy. {t(locale, "footer.copyright")}.</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={localizePath(locale, "store")} class="text-sm text-neutral-500 hover:text-brand">
        {t(locale, "nav.merch")}
      </a>
      <div class="flex items-center gap-2" role="group" aria-label={t(locale, "footer.socialAriaGroup")}>
        <a
          class="footer-social-icon inline-flex size-10 items-center justify-center rounded-full border border-white/15 text-neutral-400 transition hover:border-white/30 hover:text-white"
          href={site.instagramUrl}
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Instagram"
        >
          <svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.07 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            />
          </svg>
        </a>
        <a
          class="footer-social-icon inline-flex size-10 items-center justify-center rounded-full border border-white/15 text-neutral-400 transition hover:border-white/30 hover:text-white"
          href={site.facebookUrl}
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Facebook"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            />
          </svg>
        </a>
        <a
          class="footer-social-icon inline-flex size-10 items-center justify-center rounded-full border border-white/15 text-neutral-400 transition hover:border-white/30 hover:text-white"
          href={site.linkedInUrl}
          target="_blank"
          rel="noreferrer noopener"
          aria-label="LinkedIn"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            />
          </svg>
        </a>
        <a
          class="footer-social-icon inline-flex size-10 items-center justify-center rounded-full border border-white/15 text-neutral-400 transition hover:border-emerald-400/80 hover:text-emerald-400"
          href={whatsappHref}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={t(locale, "footer.linkWhatsApp")}
        >
          <svg class="size-[1.2rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
